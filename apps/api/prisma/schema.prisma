generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum Category {
  RECEPTIONIST
  HOUSEKEEPER
  SECURITY_GUARD
  WAITER

  @@map("category")
}

enum RoomTypeStatus {
  ACTIVE
  INACTIVE

  @@map("room_types_status")
}

enum OccupancyStatus {
  VACANT
  RESERVED
  OCCUPIED
  OUT_OF_ORDER

  @@map("occupancy_status")
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  CLEANING

  @@map("housekeeping_status")
}

enum AmenityStatus {
  ACTIVE
  INACTIVE

  @@map("amenities_status")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW

  @@map("booking_status")
}

enum TaskType {
  CLEANING
  DEEP_CLEAN
  TURNDOWN

  @@map("task_type")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED

  @@map("task_status")
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED

  @@map("invoice_status")
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum MaintenanceReportCategory {
  ELECTRICAL
  PLUMBING
  HVAC
  FURNITURE
  APPLIANCE
  OTHER

  @@map("maintenance_reports_category")
}

enum MaintenanceReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("maintenance_reports_priority")
}

enum MaintenanceReportStatus {
  REPORTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  RESOLVED

  @@map("maintenance_reports_status")
}

enum NotificationType {
  BOOKING_CONFIRMED
  CHECK_IN_REMINDER
  PAYMENT_RECEIVED
  MAINTENANCE_CREATED
  MAINTENANCE_ASSIGNED
  MAINTENANCE_UPDATED
  HOUSEKEEPING_ASSIGNED
  BOOKING_CANCELLED

  @@map("notification_types")
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                      String                        @id @default(cuid())
  fullName                String                        @map("full_name") @db.VarChar
  email                   String                        @unique @db.VarChar
  phone                   String                        @db.VarChar
  passwordHash            String                        @map("password_hash") @db.VarChar
  profileImage            String                        @map("profile_image") @db.VarChar
  role                    UserRole
  status                  UserStatus
  lastLoginAt             DateTime?                     @map("last_login_at") @db.Timestamp
  createdAt               DateTime                      @default(now()) @map("created_at") @db.Timestamp
  updatedAt               DateTime                      @updatedAt @map("updated_at") @db.Timestamp

  staff                   Staff?
  customerProfile         CustomerProfile?
  customerBookings        Booking[]                     @relation("BookingCustomer")
  createdBookings         Booking[]                     @relation("BookingCreatedBy")
  housekeepingTasks       HousekeepingTask[]            @relation("HousekeeperTasks")
  housekeeperAssignments  HousekeeperRoomAssignment[]   @relation("Housekeeper")
  assignedAssignments     HousekeeperRoomAssignment[]   @relation("AssignedByHousekeeper")
  invoices                Invoice[]
  paymentsAsCustomer      Payment[]                     @relation("PaymentCustomer")
  paymentsRecorded        Payment[]                     @relation("PaymentRecordedBy")
  reportedMaintenances    MaintenanceReport[]           @relation("ReportedBy")
  assignedMaintenances    MaintenanceReport[]           @relation("AssignedTo")
  reviews                 Review[]
  notifications           Notification[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]

  @@map("users")
}

model Staff {
  id               String   @id @default(cuid()) 
  userId           String   @unique @map("user_id") 
  fatherName       String   @map("father_name") @db.VarChar
  motherName       String   @map("mother_name") @db.VarChar
  idProofImage     String   @map("id_proof_image") @db.VarChar
  idProofNumber    String   @map("id_proof_number") @db.VarChar
  qualification    String   @db.VarChar
  experience       String   @db.VarChar
  category         Category
  emergencyContact String   @map("emergency_contact") @db.VarChar
  address          String   @db.Text
  signature        String   @db.VarChar
  status           String   @db.VarChar
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff")
}

model CustomerProfile {
  id            String   @id @default(cuid()) 
  userId        String   @unique @map("user_id") 
  idProofImage  String   @map("id_proof_image") @db.VarChar
  idProofNumber String   @map("id_proof_number") @db.VarChar
  address       String   @db.Text
  signature     String   @db.VarChar
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model RoomType {
  id                String            @id @default(cuid()) 
  name              String            @db.VarChar
  description       String?           @db.Text
  capacity          Int
  basePrice         Decimal           @map("base_price") @db.Decimal(12, 2)
  status            RoomTypeStatus
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamp
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamp

  rooms             Room[]
  roomTypeAmenities RoomTypeAmenity[]
  bookingRooms      BookingRoom[]

  @@map("room_types")
}

model Room {
  id                  String                      @id @default(cuid()) 
  roomNumber          String                      @unique @map("room_number") @db.VarChar
  roomTypeId          String                      @map("room_type_id") 
  floor               Int
  description         String?                     @db.Text
  occupancyStatus     OccupancyStatus             @map("occupancy_status")
  housekeepingStatus  HousekeepingStatus          @map("housekeeping_status")
  isActive            Boolean                     @map("is_active")
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamp
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.Timestamp

  roomType            RoomType                    @relation(fields: [roomTypeId], references: [id])
  bookingRooms        BookingRoom[]
  housekeepingTasks   HousekeepingTask[]
  housekeeperAssigns  HousekeeperRoomAssignment[]
  maintenanceReports  MaintenanceReport[]

  @@map("rooms")
}

model Amenity {
  id                String            @id @default(cuid()) 
  name              String            @unique @db.VarChar
  description       String?           @db.Text
  icon              String?           @db.VarChar
  status            AmenityStatus
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamp
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamp

  roomTypeAmenities RoomTypeAmenity[]

  @@map("amenities")
}

model RoomTypeAmenity {
  roomTypeId String   @map("room_type_id") 
  amenityId  String   @map("amenity_id") 

  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, amenityId])
  @@map("room_type_amenities")
}

model Booking {
  id               String         @id @default(cuid()) 
  bookingReference String         @unique @map("booking_reference") @db.VarChar
  customerId       String         @map("customer_id") 
  checkInDate      DateTime       @map("check_in_date") @db.Date
  checkOutDate     DateTime       @map("check_out_date") @db.Date
  totalGuests      Int            @map("total_guests")
  totalAmount      Decimal        @map("total_amount") @db.Decimal(12, 2)
  specialRequest   String?        @map("special_request") @db.Text
  status           BookingStatus
  bookedAt         DateTime       @map("booked_at") @db.Timestamp
  checkedInAt      DateTime?      @map("checked_in_at") @db.Timestamp
  checkedOutAt     DateTime?      @map("checked_out_at") @db.Timestamp
  cancelledAt      DateTime?      @map("cancelled_at") @db.Timestamp
  createdBy        String         @map("created_by") 
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamp
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamp

  customer         User           @relation("BookingCustomer", fields: [customerId], references: [id])
  creator          User           @relation("BookingCreatedBy", fields: [createdBy], references: [id])
  bookingRooms     BookingRoom[]
  bookingGuests    BookingGuest[]
  invoices         Invoice[]
  payments         Payment[]
  review           Review?

  @@map("bookings")
}

model BookingRoom {
  id             String    @id @default(cuid()) 
  bookingId      String    @map("booking_id") 
  roomTypeId     String    @map("room_type_id") 
  assignedRoomId String?   @map("assigned_room_id") 
  pricePerNight  Decimal   @map("price_per_night") @db.Decimal(12, 2)

  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType       RoomType  @relation(fields: [roomTypeId], references: [id])
  assignedRoom   Room?     @relation(fields: [assignedRoomId], references: [id])

  @@map("booking_rooms")
}

model BookingGuest {
  id            String   @id @default(cuid()) 
  bookingId     String   @map("booking_id") 
  fullName      String   @map("full_name") @db.VarChar
  age           Int
  gender        String   @db.VarChar
  idProofNumber String?  @map("id_proof_number") @db.VarChar

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_guests")
}

model HousekeepingTask {
  id            String     @id @default(cuid()) 
  roomId        String     @map("room_id") 
  assignedTo    String     @map("assigned_to") 
  taskType      TaskType   @map("task_type")
  status        TaskStatus
  scheduledDate DateTime   @map("scheduled_date") @db.Date
  startedAt     DateTime?  @map("started_at") @db.Timestamp
  completedAt   DateTime?  @map("completed_at") @db.Timestamp
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamp
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamp

  room          Room       @relation(fields: [roomId], references: [id])
  assignee      User       @relation("HousekeeperTasks", fields: [assignedTo], references: [id])

  @@map("housekeeping_tasks")
}

model HousekeeperRoomAssignment {
  id            String   @id @default(cuid()) 
  housekeeperId String   @map("housekeeper_id") 
  roomId        String   @map("room_id") 
  assignedBy    String   @map("assigned_by") 
  isActive      Boolean  @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp

  housekeeper   User     @relation("Housekeeper", fields: [housekeeperId], references: [id])
  room          Room     @relation(fields: [roomId], references: [id])
  assigner      User     @relation("AssignedByHousekeeper", fields: [assignedBy], references: [id])

  @@unique([housekeeperId, roomId])
  @@map("housekeeper_room_assignments")
}

model Invoice {
  id             String        @id @default(cuid()) 
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar
  bookingId      String        @map("booking_id") 
  customerId     String        @map("customer_id") 
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal       @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  status         InvoiceStatus
  issuedAt       DateTime      @map("issued_at") @db.Timestamp
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamp

  booking        Booking       @relation(fields: [bookingId], references: [id])
  customer       User          @relation(fields: [customerId], references: [id])
  payments       Payment[]

  @@map("invoices")
}

model Payment {
  id               String        @id @default(cuid()) 
  paymentReference String        @unique @map("payment_reference") @db.VarChar
  transactionId   String?       @map("transaction_id") @db.VarChar
  invoiceId        String        @map("invoice_id") 
  bookingId        String        @map("booking_id") 
  customerId       String        @map("customer_id") 
  amount           Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @map("payment_method")
  paymentStatus    PaymentStatus @map("payment_status")
  paidAt           DateTime?     @map("paid_at") @db.Timestamp
  recordedBy       String?       @map("recorded_by") 
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamp

  invoice          Invoice       @relation(fields: [invoiceId], references: [id])
  booking          Booking       @relation(fields: [bookingId], references: [id])
  customer         User          @relation("PaymentCustomer", fields: [customerId], references: [id])
  recorder         User?         @relation("PaymentRecordedBy", fields: [recordedBy], references: [id])

  @@map("payments")
}

model MaintenanceReport {
  id              String                    @id @default(cuid()) 
  reportReference String                    @unique @map("report_reference") @db.VarChar
  roomId          String                    @map("room_id") 
  reportedBy      String                    @map("reported_by") 
  category        MaintenanceReportCategory
  priority        MaintenanceReportPriority
  description     String                    @db.Text
  photoUrl        String?                   @map("photo_url") @db.VarChar
  status          MaintenanceReportStatus
  assignedTo      String?                   @map("assigned_to") 
  reportedAt      DateTime                  @map("reported_at") @db.Timestamp
  startedAt       DateTime?                 @map("started_at") @db.Timestamp
  completedAt     DateTime?                 @map("completed_at") @db.Timestamp
  resolvedAt      DateTime?                 @map("resolved_at") @db.Timestamp
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamp
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamp

  room            Room                      @relation(fields: [roomId], references: [id])
  reporter        User                      @relation("ReportedBy", fields: [reportedBy], references: [id])
  assignee        User?                     @relation("AssignedTo", fields: [assignedTo], references: [id])

  @@map("maintenance_reports")
}

model Review {
  id         String   @id @default(cuid()) 
  bookingId  String   @unique @map("booking_id") 
  customerId String   @map("customer_id") 
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer   User     @relation(fields: [customerId], references: [id])

  @@map("reviews")
}

model Notification {
  id            String           @id @default(cuid()) 
  userId        String           @map("user_id") 
  type          NotificationType
  title         String           @db.VarChar
  message       String           @db.Text
  referenceType String?          @map("reference_type") @db.VarChar
  referenceId   String?          @map("reference_id") 
  isRead        Boolean          @map("is_read")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamp
  readAt        DateTime?        @map("read_at") @db.Timestamp

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Session {
  id               String         @id @default(cuid()) 
  userId           String         @map("user_id") 
  sessionTokenHash String         @unique @map("session_token_hash") @db.VarChar
  ipAddress        String?        @map("ip_address") @db.VarChar
  userAgent        String?        @map("user_agent") @db.Text
  deviceName       String?        @map("device_name") @db.VarChar
  expiresAt        DateTime       @map("expires_at") @db.Timestamp
  lastUsedAt       DateTime       @map("last_used_at") @db.Timestamp
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamp
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamp

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens    RefreshToken[]

  @@map("sessions")
}

model RefreshToken {
  id                String    @id @default(cuid()) 
  sessionId         String    @map("session_id") 
  tokenHash         String    @unique @map("token_hash") @db.VarChar
  expiresAt         DateTime  @map("expires_at") @db.Timestamp
  usedAt            DateTime? @map("used_at") @db.Timestamp
  revokedAt         DateTime? @map("revoked_at") @db.Timestamp
  replacedByTokenId String?   @map("replaced_by_token_id") 
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp

  session           Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid()) 
  userId    String    @map("user_id") 
  tokenHash String    @unique @map("token_hash") @db.VarChar
  expiresAt DateTime  @map("expires_at") @db.Timestamp
  usedAt    DateTime? @map("used_at") @db.Timestamp
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model AuditLog {
  id         String   @id @default(cuid()) 
  userId     String?  @map("user_id") 
  action     String   @db.VarChar
  entityType String   @map("entity_type") @db.VarChar
  entityId   String?  @map("entity_id") 
  oldValues  Json?    @map("old_values") @db.JsonB
  newValues  Json?    @map("new_values") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp

  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}